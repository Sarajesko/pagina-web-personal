# Copiar a .env y ajustar valores (nunca subir .env al repo)
# cp .env.example .env   # macOS / Linux
# copy .env.example .env # Windows

# Clave para firmar cookies de sesión admin (generar una aleatoria en producción)
SECRET_KEY=dev-change-me-in-production

# Ruta al archivo SQLite (por defecto: backend/instance/portfolio.db)
# DATABASE_PATH=instance/portfolio.db

# Credenciales admin — se crean al ejecutar init_db.py si no existen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Duración de sesión admin en segundos (por defecto: 28800 = 8 h)
# SESSION_MAX_AGE=28800

# Orígenes CORS — separados por coma
# * = solo localhost/127.0.0.1 en cualquier puerto (desarrollo; compatible con cookies)
# Producción: lista explícita, p. ej. https://tudominio.github.io,https://www.tudominio.com
CORS_ORIGINS=*
