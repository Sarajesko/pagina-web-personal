# Copiar a la raíz del repo como `.env` (no subir a Git):
#   cp deploy/env.example .env

# Dirección que ve Caddy:
# - Con dominio (recomendado, HTTPS automático):
SITE_ADDRESS=portfolio.tudominio.com
# - Solo IP del VPS (HTTP, pruebas):
# SITE_ADDRESS=:80

ENV=production
SERVE_FRONTEND=true

# Generar: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-password-fuerte

# Misma URL pública (esquema https si tienes dominio)
CORS_ORIGINS=https://portfolio.tudominio.com

# Mismo origen (Caddy → API): lax + https
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true

# Si usas solo IP (HTTP), usa en su lugar:
# CORS_ORIGINS=http://TU.IP.PUBLICA
# SESSION_HTTPS_ONLY=false
